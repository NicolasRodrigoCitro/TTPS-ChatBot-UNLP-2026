# Configuración de Flask
SECRET_KEY=dev-secret-key-change-in-production

# Base de Datos PostgreSQL - Cambia estos valores según tu configuración local
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chatbot_db
# Si no usas docker y tu PostgreSQL está en localhost, podes usar:
# DB_HOST=localhost
# DB_PORT=5432


# Hugging Face API
HUGGINGFACE_API_TOKEN=tu_token_de_huggingface_aqui

# Ollama (desacoplado del stack principal)
# Durante desarrollo en la MISMA máquina:
#   - Docker Desktop (Win/Mac): usa host.docker.internal
#   - Linux: usa la IP del host Docker (ej: 172.17.0.1) o tu IP local
# En producción (máquina distinta): http://<IP_OLLAMA>:11434
OLLAMA_URL=http://host.docker.internal:11434

# El modelo está definido en los docker compose, pero se debería poder elegir otro con esta variable
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text